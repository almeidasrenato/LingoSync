{
  "asrSeconds" : 7.5495610237121582,
  "cues" : [
    {
      "end" : 5.2399997711181641,
      "speaker" : null,
      "start" : 0,
      "text" : "はぁ~ もしもーし!"
    },
    {
      "end" : 10.119999885559082,
      "speaker" : "Locutor 1",
      "start" : 6.6500000953674316,
      "text" : "俺の名は、モンキー・D・ルフィ!"
    },
    {
      "end" : 12.420000076293945,
      "speaker" : "Locutor 1",
      "start" : 10.439999580383301,
      "text" : "海賊王になる男だ!"
    },
    {
      "end" : 14.979999542236328,
      "speaker" : "Locutor 2",
      "start" : 13.05000114440918,
      "text" : "おい、ルフィ!何言ってんだ!"
    },
    {
      "end" : 18.799999237060547,
      "speaker" : "Locutor 1",
      "start" : 15.550000190734863,
      "text" : "ドクター・ベガ・パンクは俺たちがもらった!"
    },
    {
      "end" : 29.879999160766602,
      "speaker" : "Locutor 1",
      "start" : 19.690000534057617,
      "text" : "よくの命が惜しければ、海岸の船を全部どけろ! 早く助けて"
    },
    {
      "end" : 33.200000762939453,
      "speaker" : "Locutor 1",
      "start" : 30.710006713867188,
      "text" : "何やってんのよ五老星"
    },
    {
      "end" : 37.720001220703125,
      "speaker" : "Locutor 1",
      "start" : 33.890003204345703,
      "text" : "ここから出して 助けて"
    },
    {
      "end" : 40.279998779296875,
      "speaker" : "Locutor 1",
      "start" : 38.349998474121094,
      "text" : "麦わらに殺される"
    },
    {
      "end" : 45.639999389648438,
      "speaker" : "Locutor 2",
      "start" : 42.169998168945312,
      "text" : "ドアクト 噂に違わぬ凶悪さ"
    },
    {
      "end" : 48.459999084472656,
      "speaker" : "Locutor 2",
      "start" : 47.270000457763672,
      "text" : "どういうことだ"
    },
    {
      "end" : 50.959999084472656,
      "speaker" : "Locutor 1",
      "start" : 48.989997863769531,
      "text" : "えぇ ルフィーさん"
    },
    {
      "end" : 60.439998626708984,
      "speaker" : "Locutor 2",
      "start" : 51.290000915527344,
      "text" : "何が起きてる 五老星相手に 相変わらず権力をカバにしてやがる ん みんな!"
    },
    {
      "end" : 66.779998779296875,
      "speaker" : "Locutor 2",
      "start" : 65.009994506835938,
      "text" : "麦わらのルフィか"
    },
    {
      "end" : 69.520004272460938,
      "speaker" : "Locutor 1",
      "start" : 67.470001220703125,
      "text" : "そうだ!なんか文句あっか?"
    },
    {
      "end" : 71.720001220703125,
      "speaker" : "Locutor 2",
      "start" : 69.770004272460938,
      "text" : "いや、それ以上挑発するな!"
    },
    {
      "end" : 76.760002136230469,
      "speaker" : "Locutor 3",
      "start" : 72.489997863769531,
      "text" : "エッグヘッドの中では今、誰が生き残っている?"
    },
    {
      "end" : 83.110000610351562,
      "speaker" : "Locutor 1",
      "start" : 78.149993896484375,
      "text" : "えーっと、怪我してるやつもいて ダメ!"
    },
    {
      "end" : 86.139999389648438,
      "speaker" : "Locutor 3",
      "start" : 84.889999389648438,
      "text" : "ガチャ ん?"
    }
  ],

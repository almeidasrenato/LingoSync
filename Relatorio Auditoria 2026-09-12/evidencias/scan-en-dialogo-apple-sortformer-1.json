{
  "asrSeconds" : 1.0495110750198364,
  "cues" : [
    {
      "end" : 1.74,
      "speaker" : "Locutor 1",
      "start" : 0,
      "text" : "Come in, Egghead."
    },
    {
      "end" : 3.8999999999999999,
      "speaker" : "Locutor 2",
      "start" : 1.74,
      "text" : "What the hell is going on over there?"
    },
    {
      "end" : 6.0599999999999996,
      "speaker" : "Locutor 2",
      "start" : 3.8999999999999999,
      "text" : "What was that broadcast?"
    },
    {
      "end" : 8.2200000000000006,
      "speaker" : "Locutor 2",
      "start" : 6.0599999999999996,
      "text" : "I need a status report immediately."
    },
    {
      "end" : 10.960000000000001,
      "speaker" : "Locutor 2",
      "start" : 8.2200000000000006,
      "text" : "Come in, goddamn it! Again?"
    },
    {
      "end" : 13.06,
      "speaker" : "Locutor 3",
      "start" : 10.960000000000001,
      "text" : "Oh, shut it already. What"
    },
    {
      "end" : 14.06,
      "speaker" : "Locutor 1",
      "start" : 13.06,
      "text" : "happened to everyone else?"
    },
    {
      "end" : 15.84,
      "speaker" : "Locutor 3",
      "start" : 14.06,
      "text" : "Alive, but knocked out."
    },
    {
      "end" : 17.34,
      "speaker" : "Locutor 3",
      "start" : 15.84,
      "text" : "Every last one of them."
    },
    {
      "end" : 23.280000000000001,
      "speaker" : "Locutor 3",
      "start" : 17.809999999999999,
      "text" : "Once these kids wake up, I'll have them give you a report. You'd"
    },
    {
      "end" : 25.84,
      "speaker" : "Locutor 1",
      "start" : 23.280000000000001,
      "text" : "better not be doing a sloppy job. Saint"
    },
    {
      "end" : 27.120000000000001,
      "speaker" : "Locutor 2",
      "start" : 25.84,
      "text" : "Saturn had better be safe."
    },
    {
      "end" : 28.920000000000002,
      "speaker" : "Locutor 2",
      "start" : 27.120000000000001,
      "text" : "What happened to the power plant?"
    },
    {
      "end" : 30.300000000000001,
      "speaker" : "Locutor 2",
      "start" : 28.920000000000002,
      "text" : "And where are the fugitives?"
    },
    {
      "end" : 33.719999999999999,
      "speaker" : "Locutor 1",
      "start" : 31.489999999999998,
      "text" : "Let me ask you something."
    },
    {
      "end" : 35.700000000000003,
      "speaker" : "Locutor 1",
      "start" : 33.719999999999999,
      "text" : "Sakazuki."
    },
    {
      "end" : 42.420000000000002,
      "speaker" : "Locutor 1",
      "start" : 38.689999999999998,
      "text" : "Have you ever been ordered to kill your best friend?"
    },
    {
      "end" : 45.060000000000002,
      "speaker" : "Locutor 1",
      "start" : 42.420000000000002,
      "text" : "That's one hell of a head you've got there."
    },
    {
      "end" : 47.399999999999999,
      "speaker" : "Locutor 1",
      "start" : 45.060000000000002,
      "text" : "Anyhow, nice to meet you."
    },
    {
      "end" : 50.140000000000001,
      "speaker" : "Locutor 1",
      "start" : 47.399999999999999,
      "text" : "Name's Borcelino. How"
    },
    {
      "end" : 51.140000000000001,
      "speaker" : "Locutor 3",
      "start" : 50.140000000000001,
      "text" : "much can you offer?"
    },
    {
      "end" : 57.140000000000001,
      "speaker" : "Locutor 3",
      "start" : 51.140000000000001,
      "text" : "I know the government really wants me for my brain, but I need funding. You're funny."
    },
    {
      "end" : 58.140000000000001,
      "speaker" : "Locutor 1",
      "start" : 57.140000000000001,
      "text" : "I like that."
    },
    {
      "end" : 61.119999999999997,
      "speaker" : "Locutor 1",
      "start" : 58.140000000000001,
      "text" : "You realize I'm an admiral now, don't you? Watch"
    },
    {
      "end" : 62.119999999999997,
      "speaker" : "Locutor 3",
      "start" : 61.119999999999997,
      "text" : "your posture, Uncle."
    },
    {
      "end" : 64.799999999999997,
      "speaker" : "Locutor 3",
      "start" : 62.119999999999997,
      "text" : "Don't want to drop those on your foot. So"
    },
    {
      "end" : 67.200000000000003,
      "speaker" : "Locutor 1",
      "start" : 64.799999999999997,
      "text" : "this is your plan for the island? Yes,"
    },
    {
      "end" : 68.879999999999995,
      "speaker" : "Locutor 3",
      "start" : 67.200000000000003,
      "text" : "I'm going to name it Egghead."
    },
    {
      "end" : 70.799999999999997,
      "speaker" : "Locutor 3",
      "start" : 68.879999999999995,
      "text" : "Keep it up, Mausolino."
    },
    {
      "end" : 71.799999999999997,
      "speaker" : "Locutor 3",
      "start" : 70.799999999999997,
      "text" : "I'm counting on you."
    },
    {
      "end" : 80.459999999999994,
      "speaker" : "Locutor 3",
      "start" : 75.109999999999999,
      "text" : "If you burn it down, you'll set scientific progress back essentially."
    },
    {
      "end" : 81.459999999999994,
      "speaker" : "Locutor 3",
      "start" : 80.459999999999994,
      "text" : "Please."
    },
    {
      "end" : 82.5,
      "speaker" : "Locutor 3",
      "start" : 81.459999999999994,
      "text" : "Kisalo, help."
    },
    {
      "end" : 84.5,
      "speaker" : "Locutor 3",
      "start" : 82.5,
      "text" : "Help me. You"
    },
    {
      "end" : 85.5,
      "speaker" : "Locutor 1",
      "start" : 84.5,
      "text" : "think I did a sloppy job?"
    },
    {
      "end" : 87.239999999999995,
      "speaker" : "Locutor 1",
      "start" : 85.5,
      "text" : "You think I'm being lazy?"
    },
    {
      "end" : 96,
      "speaker" : "Locutor 1",
      "start" : 93.109999999999999,
      "text" : "If you have time to sit there and tell me!"
    },
    {
      "end" : 98.280000000000001,
      "speaker" : "Locutor 1",
      "start" : 96,
      "text" : "Then you come here and look at what I've done!"
    },
    {
      "end" : 100.02,
      "speaker" : "Locutor 1",
      "start" : 98.280000000000001,
      "text" : "You little shit!"
    },
    {
      "end" : 106.08,
      "speaker" : "Locutor 2",
      "start" : 102.83,
      "text" : "I apologize, brother."
    },
    {
      "end" : 107.08,
      "speaker" : "Locutor 1",
      "start" : 106.08,
      "text" : "Shut up."
    },
    {
      "end" : 108.08,
      "speaker" : "Locutor 1",
      "start" : 107.08,
      "text" : "It's too late."
    }
  ],
